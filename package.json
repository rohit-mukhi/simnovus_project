{
  "name": "mini-device-fleet-monitor",
  "version": "1.0.0",
  "description": "A device fleet monitoring application with heartbeat tracking",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "simulator": "tsx src/simulator.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "clean": "rm -r dist || rmdir /s /q dist"
  },
  "keywords": [
    "monitoring",
    "fleet",
    "heartbeat",
    "devices"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "tsx": "^4.7.0"
  }
}
